// ============================================================
// i360 Platform — Prisma Schema
// ISA-95 Compliant Enterprise Manufacturing Execution System
// i360 Ecosystem Demo — multi-industry ISA-95 platform (KSA)
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ISA-95 LEVEL 4 — ENTERPRISE
// ============================================================

model Enterprise {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  nameAr    String?
  industry  String?
  country   String   @default("SA")
  timezone  String   @default("Asia/Riyadh")
  currency  String   @default("SAR")
  language  String   @default("en")
  logoUrl   String?
  isActive  Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factories Factory[]
  users     User[]

  @@map("enterprises")
}

// ============================================================
// ISA-95 LEVEL 3 — FACTORY (SITE)
// ============================================================

model Factory {
  id                         String   @id @default(uuid())
  enterpriseId               String
  code                       String   @unique
  name                       String
  nameAr                     String?
  city                       String?
  country                    String   @default("SA")
  address                    String?
  lat                        Float?
  lng                        Float?
  color                      String   @default("#00C8FF")
  glowColor                  String   @default("rgba(0,200,255,0.3)")
  timezone                   String   @default("Asia/Riyadh")
  // ── Display unit (see common/units.util.ts) ──────────────────────────────
  // ALL internal arithmetic is done in PIECE, the smallest rung of the packaging
  // ladder, because that is the only unit in which quantities from different
  // routing steps (inners, cartons, pallets) can legitimately be added. This
  // setting controls only how those totals are PRESENTED, so changing it can
  // never alter a stored quantity or a calculation — it is a rendering choice.
  // Deliberately separate from SKU.baseUnit, which governs inventory stock and
  // must not be repurposed for display.
  displayUnit                String   @default("INNER")
  /// Write the shift schedule into machine state history.
  ///
  /// OFF by default, deliberately. Turning it on makes planned-stop
  /// TEMPLATES author `machine_state_records`, which is the right shape only
  /// for a plant whose breaks genuinely repeat on a rule. A plant that plans
  /// day by day should book dated downtime events instead, and would find a
  /// recurring template writing windows nobody scheduled.
  plannedStopMaterialisation Boolean  @default(false)
  isActive                   Boolean  @default(true)
  metadata                   Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  enterprise             Enterprise             @relation(fields: [enterpriseId], references: [id])
  areas                  Area[]
  productionLines        ProductionLine[]
  machines               Machine[]
  users                  User[]
  skus                   SKU[]
  productCategories      ProductCategory[]
  productBrands          ProductBrand[]
  packagingTypes         PackagingType[]
  baseUnits              BaseUnit[]
  baseWeights            BaseWeight[]
  unitsOfMeasure         UnitOfMeasure[]
  changeRequests         ChangeRequest[]
  shifts                 ShiftTemplate[]
  shiftInstances         ShiftInstance[]
  productionOrders       ProductionOrder[]
  workOrders             WorkOrder[]
  batchRecords           BatchRecord[]
  materialLots           MaterialLot[]
  rawMaterials           RawMaterial[]
  storageLocations       StorageLocation[]
  stockMovements         StockMovement[]
  traceEvents            TraceEvent[]
  downtimeCauses         DowntimeCause[]
  downtimeEvents         DowntimeEvent[]
  oeeRecords             OEERecord[]
  machineStates          MachineStateRecord[]
  qualityPlans           QualityPlan[]
  inspectionResults      InspectionResult[]
  ncrs                   NCR[]
  capas                  CAPA[]
  spcMeasurements        SPCMeasurement[]
  maintenanceWOs         MaintenanceWO[]
  pmPlans                PMPlan[]
  pmTasks                PMTask[]
  spareParts             SparePart[]
  manufacturingProcesses ManufacturingProcess[]
  energyMeters           EnergyMeter[]
  pqEvents               PqEvent[]
  harmonicSnapshots      HarmonicSnapshot[]
  capacitorBanks         CapacitorBank[]
  en50160Assessments     En50160Assessment[]
  energyReadings         EnergyReading[]
  energySummaries        EnergySummary[]
  energyTariffs          EnergyTariff[]
  gridEmissionFactors    GridEmissionFactor[]
  devices                Device[]
  tagDefinitions         TagDefinition[]
  gateways               Gateway[]
  alarmDefinitions       AlarmDefinition[]
  alarmEvents            AlarmEvent[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  notificationRules      NotificationRule[]
  workCenters            WorkCenter[]
  recipes                Recipe[]
  energyWOSummaries      EnergyWOSummary[]
  energyWOMachineKpis    EnergyWOMachineKpi[]
  traceabilityLinks      TraceabilityLink[]
  jobOrders              JobOrder[]
  scrapLogs              ScrapLog[]
  rescheduleRequests     RescheduleRequest[]
  finishedGoodsLots      FinishedGoodsLot[]
  materialRequests       MaterialRequest[]
  storageTransfers       StorageTransfer[]

  machineStateRules  MachineStateRule[]
  scheduleAttainment ScheduleAttainmentDaily[]

  plannedStopTemplates PlannedStopTemplate[]
  scheduleRules        ScheduleRule[]
  workOrderStopRules   WorkOrderStopRule[]
  oeeMinutes           OeeMinute[]
  oeeScheduleMinutes   OeeScheduleMinute[]

  @@map("factories")
}

// ============================================================
// ISA-95 LEVEL 3 — AREA (Making, Packing, Utility, Warehouse)
// ============================================================

model Area {
  id          String   @id @default(uuid())
  factoryId   String
  code        String
  name        String
  nameAr      String?
  type        AreaType @default(PACKING)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  factory         Factory          @relation(fields: [factoryId], references: [id])
  productionLines ProductionLine[]
  machines        Machine[]
  energyMeters    EnergyMeter[]
  energyTariffs   EnergyTariff[]
  devices         Device[]
  tagDefinitions  TagDefinition[]

  @@unique([factoryId, code])
  @@map("areas")
}

enum AreaType {
  MAKING
  PACKING
  FILLING
  UTILITY
  WAREHOUSE
  LABORATORY
  OFFICE
}

// ============================================================
// ISA-95 LEVEL 3 — PRODUCTION LINE
// ============================================================

model ProductionLine {
  id                  String    @id @default(uuid())
  factoryId           String
  areaId              String
  code                String
  name                String
  nameAr              String?
  type                LineType  @default(PACKING)
  description         String?
  isActive            Boolean   @default(true)
  sortOrder           Int       @default(0)
  // ── Line OEE calculation basis (plant PoC) ─────────────────────────────────
  // Which method produces this line's headline OEE. ROLLUP is the historic
  // quantity-weighted aggregation of every machine; BOTTLENECK measures the line
  // by its constraint. Both are legitimate — they answer different questions —
  // so the choice is explicit per line rather than imposed globally.
  oeeMethod           OeeMethod @default(ROLLUP)
  // BOTTLENECK only: the single constraint machine that sets the line's rate.
  // Null → the API falls back to the slowest routing cycle time and says so.
  bottleneckMachineId String?
  // BOTTLENECK only: the counting point(s) where saleable units leave the line.
  // A line can finish through more than one outfeed (parallel palletizers), so
  // this is a list. EMPTY = every machine on the line is treated as outfeed.
  outfeedMachineIds   String[]  @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  factory            Factory             @relation(fields: [factoryId], references: [id])
  area               Area                @relation(fields: [areaId], references: [id])
  machines           Machine[]
  workOrders         WorkOrder[]
  shiftInstances     ShiftInstance[]
  energyMeters       EnergyMeter[]
  energyTariffs      EnergyTariff[]
  devices            Device[]
  tagDefinitions     TagDefinition[]
  plannedStopTargets PlannedStopTarget[]
  workOrderStopRules WorkOrderStopRule[]

  @@unique([factoryId, code])
  @@map("production_lines")
}

/// How a production line's headline OEE is derived.
enum OeeMethod {
  /// Quantity-weighted aggregation of every machine on the line: sum the planned,
  /// run and earned minutes plus the counts, then re-derive A × P × Q from the
  /// totals. Not an average of percentages. Answers "how did the assets perform".
  ROLLUP
  /// Bottleneck Availability × Bottleneck Performance × Final Outfeed Quality.
  /// Answers "how did the LINE perform", which is what a synchronised packaging
  /// line is actually judged on — downstream assets idle by design when the
  /// constraint stops, so including them understates the line.
  BOTTLENECK
}

enum LineType {
  PACKING
  FILLING
  MAKING
  BLOW_MOLDING
  BLOW_FILM
  AEROSOL
  CUTTING_SEALING
  UTILITY
}

// ============================================================
// ISA-95 LEVEL 2 — MACHINE (EQUIPMENT)
// ============================================================

model Machine {
  archivedAt        DateTime? // soft-archive (hidden from active lists, restorable)
  id                String      @id @default(uuid())
  factoryId         String
  areaId            String?
  lineId            String?
  code              String
  name              String
  nameAr            String?
  sortOrder         Int         @default(0)
  machineType       MachineType @default(MACHINE)
  manufacturer      String?
  model             String?
  serialNumber      String?
  installDate       DateTime?
  warrantyExpiry    DateTime?
  criticality       Criticality @default(MEDIUM)
  designCapacity    Float? // units per hour
  downtimeThreshold Int         @default(60) // seconds before classifying as downtime
  isActive          Boolean     @default(true)
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  factory             Factory                    @relation(fields: [factoryId], references: [id])
  area                Area?                      @relation(fields: [areaId], references: [id])
  line                ProductionLine?            @relation(fields: [lineId], references: [id])
  currentStatus       MachineCurrentStatus?
  modules             MachineModule[]
  cycleTimes          MachineCycleTime[]
  downtimeCauses      DowntimeCause[]
  stateRecords        MachineStateRecord[]
  downtimeEvents      DowntimeEvent[]
  oeeRecords          OEERecord[]
  maintenanceWOs      MaintenanceWO[]
  pmPlans             PMPlan[]
  pmTasks             PMTask[]
  runtimeHours        MachineRuntimeHours[]
  failureModes        FailureMode[]
  inspectionResults   InspectionResult[]
  spcMeasurements     SPCMeasurement[]
  devices             Device[]
  tagDefinitions      TagDefinition[]
  alarmEvents         AlarmEvent[]
  energyMeters        EnergyMeter[]
  pqEvents            PqEvent[]
  capacitorBank       CapacitorBank?
  energyTariffs       EnergyTariff[]
  energyWOMachineKpis EnergyWOMachineKpi[]
  routingSteps        RoutingStep[]
  jobOrders           JobOrder[]
  stepOptions         RoutingStepMachineOption[]
  machineStateRules   MachineStateRule[]

  plannedStopTargets PlannedStopTarget[]
  workOrderStopRules WorkOrderStopRule[]
  oeeMinutes         OeeMinute[]
  oeeScheduleMinutes OeeScheduleMinute[]
  lineBalance        LineBalanceConfig?

  @@unique([factoryId, code])
  @@index([factoryId])
  @@index([lineId])
  @@map("machines")
}

enum MachineType {
  MACHINE
  PRODUCTION_LINE
  CONVEYOR
  ROBOT
  PALLETIZER
  CHECKWEIGHER
  FILLING_MACHINE
  CARTONING_MACHINE
  WRAPPING_MACHINE
  BLOW_MOLDING
  BLOW_FILM
  COMPRESSOR
  BOILER
  TRANSFORMER
  CHILLER
  ENERGY_METER
  PUMP
  MIXER
  REACTOR
  HMI
  GATEWAY
  SENSOR
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// ISA-95 LEVEL 1 — MACHINE MODULE
// ============================================================

model MachineModule {
  id          String   @id @default(uuid())
  machineId   String
  code        String
  name        String
  type        String? // DRIVE, SENSOR, VALVE, ACTUATOR, CONTROLLER
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, code])
  @@map("machine_modules")
}

// CURRENT STATUS — live snapshot
model MachineCurrentStatus {
  id              String       @id @default(uuid())
  machineId       String       @unique
  state           MachineState @default(OFFLINE)
  currentSKUId    String?
  currentWOId     String?
  oee             Float?
  availability    Float?
  performance     Float?
  quality         Float?
  actualSpeed     Float? // units/hour
  targetSpeed     Float?
  goodCount       Int          @default(0)
  rejectCount     Int          @default(0)
  downtimeMinutes Float        @default(0)
  runtimeMinutes  Float        @default(0)
  lastEventAt     DateTime?
  updatedAt       DateTime     @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@map("machine_current_status")
}

enum MachineState {
  RUNNING
  IDLE
  PLANNED_STOP
  BREAKDOWN
  SETUP
  CHANGEOVER
  /// Bringing the line up to speed at the head of a shift. Intended work, and
  /// still a loss — one of the six big losses — so its rule charges OEE.
  STARTUP
  STARVED
  BLOCKED
  OFFLINE
  MAINTENANCE
}

// ============================================================
// MACHINE CYCLE TIME (per SKU per machine — from the plant data)
// ============================================================

model MachineCycleTime {
  id               String   @id @default(uuid())
  machineId        String
  skuId            String
  // Float, not Int: fast machines run well under a second per unit (Powder Filler
  // measures 1.2 s/inner pack), and rounding that to a whole second is a 20%
  // error straight into the OEE Performance denominator. Matches the Float on
  // JobOrder.idealCycleTimeSec.
  cycleTimeSeconds Float
  unitType         String   @default("UNIT") // UNIT, INNER, CARTON, PALLET
  maxSpeed         Float? // units per hour (theoretical max)
  source           String   @default("PLANT_DATA") // PLANT_DATA, MEASURED, CALCULATED
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])
  sku     SKU     @relation(fields: [skuId], references: [id])

  @@unique([machineId, skuId, unitType])
  @@map("machine_cycle_times")
}

// ============================================================
// PRODUCT & SKU MASTER DATA
// ============================================================

model ProductFamily {
  id        String   @id @default(uuid())
  factoryId String
  code      String
  name      String
  nameAr    String?
  brand     String?
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  skus SKU[]

  @@unique([factoryId, code])
  @@map("product_families")
}

// ── PLM ENGINEERING CHANGE REQUESTS ──────────────────────────────────────────
enum ChangeRequestType {
  BOM_CHANGE
  RECIPE_CHANGE
  PROCESS_CHANGE
  DESIGN_CHANGE
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

model ChangeRequest {
  id            String              @id @default(uuid())
  factoryId     String
  crNumber      String // ECR-2026-001
  title         String
  description   String?
  type          ChangeRequestType
  status        ChangeRequestStatus @default(DRAFT)
  priority      Priority            @default(MEDIUM)
  skuId         String? // affected product
  processId     String? // affected manufacturing process (PROCESS_CHANGE governance)
  requestedById String?
  reviewedById  String?
  reason        String?
  targetDate    DateTime?
  implementedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  factory     Factory               @relation(fields: [factoryId], references: [id])
  sku         SKU?                  @relation(fields: [skuId], references: [id])
  process     ManufacturingProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  requestedBy User?                 @relation("CRRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?                 @relation("CRReviewedBy", fields: [reviewedById], references: [id])

  @@unique([factoryId, crNumber])
  @@index([factoryId, status])
  @@map("change_requests")
}

// ── PRODUCT MASTER DATA (managed lookups powering the product form) ─────────
model ProductCategory {
  id        String   @id @default(uuid())
  factoryId String
  name      String
  nameAr    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  factory   Factory                @relation(fields: [factoryId], references: [id])
  skus      SKU[]
  processes ManufacturingProcess[]

  @@unique([factoryId, name])
  @@map("product_categories")
}

model ProductBrand {
  id        String   @id @default(uuid())
  factoryId String
  name      String
  nameAr    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  factory Factory @relation(fields: [factoryId], references: [id])
  skus    SKU[]

  @@unique([factoryId, name])
  @@map("product_brands")
}

model PackagingType {
  id        String   @id @default(uuid())
  factoryId String
  name      String
  nameAr    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  factory Factory @relation(fields: [factoryId], references: [id])
  skus    SKU[]

  @@unique([factoryId, name])
  @@map("packaging_types")
}

model BaseUnit {
  id        String   @id @default(uuid())
  factoryId String
  code      String // PCS, CARTON, PALLET, KG …
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  factory Factory @relation(fields: [factoryId], references: [id])
  skus    SKU[]

  @@unique([factoryId, code])
  @@map("base_units")
}

model BaseWeight {
  id        String   @id @default(uuid())
  factoryId String
  value     Float // e.g. 2.25
  unit      String   @default("kg")
  label     String? // e.g. "2.25 Kg"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  factory   Factory                @relation(fields: [factoryId], references: [id])
  skus      SKU[]
  processes ManufacturingProcess[]

  @@unique([factoryId, value, unit])
  @@map("base_weights")
}

// ============================================================
// UNIFIED UNIT OF MEASURE (canonical units + conversion factors)
// Single source of truth for units across raw materials, BOM lines,
// routing-step materials and material lots. PACKAGING-category units
// (INNER/CARTON/PALLET) convert through the SKU packaging ladder, not factors.
// ============================================================

enum UomCategory {
  WEIGHT
  VOLUME
  COUNT
  PACKAGING
  LENGTH
  AREA
  TIME
}

model UnitOfMeasure {
  id               String      @id @default(uuid())
  factoryId        String
  code             String // KG, G, TON, L, ML, PCS, INNER, CARTON, PALLET, ROLL, M
  name             String
  nameAr           String?
  category         UomCategory
  baseUnitCode     String? // canonical unit of the category (KG / L / PCS)
  conversionFactor Float       @default(1) // 1 of this unit = factor × baseUnitCode (G = 0.001 KG)
  decimals         Int         @default(3)
  sortOrder        Int         @default(0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  factory              Factory               @relation(fields: [factoryId], references: [id])
  rawMaterials         RawMaterial[]
  bomItems             BOMItem[]
  routingStepMaterials RoutingStepMaterial[]
  materialLots         MaterialLot[]

  @@unique([factoryId, code])
  @@map("units_of_measure")
}

model SKU {
  archivedAt       DateTime? // soft-archive (hidden from active lists, restorable)
  id               String    @id @default(uuid())
  factoryId        String
  familyId         String?
  itemNumber       String // the plant SAP item number (e.g. 10310064)
  code             String // Internal code
  name             String
  nameAr           String?
  shortName        String?
  brand            String? // legacy text (kept in sync with brandRef.name)
  category         String? // legacy text (kept in sync with categoryRef.name)
  // Master-data relations (preferred; the legacy strings stay synced)
  categoryId       String?
  brandId          String?
  packagingTypeId  String?
  baseUnitId       String?
  baseWeightId     String?
  weight           Float?
  weightUnit       String    @default("kg")
  length           Float?
  width            Float?
  height           Float?
  dimensionUnit    String    @default("cm")
  packagingType    String? // legacy text (kept in sync with packagingTypeRef.name)
  unitsPerInner    Int       @default(1)
  innersPerCarton  Int       @default(1)
  cartonsPerPallet Int       @default(1)
  baseUnit         String    @default("EA") // legacy text (kept in sync with baseUnitRef.code)
  currentStock     Float     @default(0) // finished-goods on-hand in base units (sum of active finished_goods_lots)
  isActive         Boolean   @default(true)
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  storageLocationId String? // FK to StorageLocation (finished goods / dispatch)

  factory                Factory                   @relation(fields: [factoryId], references: [id])
  family                 ProductFamily?            @relation(fields: [familyId], references: [id])
  storageLocationRef     StorageLocation?          @relation(fields: [storageLocationId], references: [id])
  categoryRef            ProductCategory?          @relation(fields: [categoryId], references: [id])
  brandRef               ProductBrand?             @relation(fields: [brandId], references: [id])
  packagingTypeRef       PackagingType?            @relation(fields: [packagingTypeId], references: [id])
  baseUnitRef            BaseUnit?                 @relation(fields: [baseUnitId], references: [id])
  baseWeightRef          BaseWeight?               @relation(fields: [baseWeightId], references: [id])
  cycleTimes             MachineCycleTime[]
  bomComponents          BOMComponent[]
  bomHeaders             BOMHeader[]
  workOrders             WorkOrder[]
  productionOrders       ProductionOrder[]
  batchRecords           BatchRecord[]
  manufacturingProcesses ManufacturingProcess[]
  processLinks           ManufacturingProcessSku[]
  recipes                Recipe[]
  changeRequests         ChangeRequest[]
  finishedGoodsLots      FinishedGoodsLot[]
  workOrderStopRules     WorkOrderStopRule[]

  @@unique([factoryId, itemNumber])
  @@index([factoryId])
  @@index([categoryId])
  @@index([baseWeightId])
  @@map("skus")
}

model BOMComponent {
  id            String   @id @default(uuid())
  skuId         String
  componentCode String
  componentName String
  quantity      Float
  unit          String
  type          String   @default("RAW") // RAW, PACKAGING, CONSUMABLE
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  sku SKU @relation(fields: [skuId], references: [id])

  @@map("bom_components")
}

// ============================================================
// PRODUCTION EXECUTION
// ============================================================

// PRODUCTION ORDER (ERP / SAP level)
model ProductionOrder {
  archivedAt     DateTime? // soft-archive (hidden from active lists, restorable)
  id             String                @id @default(uuid())
  factoryId      String
  orderNumber    String                @unique
  sapOrderNumber String?
  skuId          String?
  targetQty      Int
  completedQty   Int                   @default(0)
  unit           String                @default("CARTON")
  status         ProductionOrderStatus @default(PLANNED)
  // Rolled-up OEE from child work orders (engine: see docs/DESIGN-oee-kpi-engine.md)
  oee            Float?
  availability   Float?
  performance    Float?
  quality        Float?
  priority       Priority              @default(MEDIUM)
  plannedStart   DateTime
  plannedEnd     DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  customer       String?
  notes          String?
  sapSync        Boolean               @default(false)
  sapSyncedAt    DateTime?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  factory            Factory                   @relation(fields: [factoryId], references: [id])
  sku                SKU?                      @relation(fields: [skuId], references: [id])
  workOrders         WorkOrder[]
  rescheduleRequests RescheduleRequest[]
  stopPlan           ProductionOrderStop[]
  materialRequests   MaterialRequest[]
  scheduleAttainment ScheduleAttainmentDaily[]

  @@index([factoryId, status])
  @@map("production_orders")
}

// ── RESCHEDULE GOVERNANCE ───────────────────────────────────────────────────
// Raised when the smart finish-time of an auto-generated work order exceeds the
// production order due date. Must be APPROVED before work orders are generated
// with the proposed dates.
model RescheduleRequest {
  id                  String           @id @default(uuid())
  factoryId           String
  productionOrderId   String
  workOrderId         String? // the specific WO (APS recalc requests)
  // Where the request came from: AUTO_GENERATE (auto-gen WO finish overrun) or
  // APS_RECALC (Recalculate-Plan save made an order late).
  source              String           @default("AUTO_GENERATE")
  status              RescheduleStatus @default(PENDING)
  reason              String?
  proposedStart       DateTime
  proposedEnd         DateTime // the computed finish the user must accept
  dueDate             DateTime?
  workContentMins     Int?
  plannedStoppageMins Int?
  // Source-specific payload: APS plan updates [{id,start,end}], step breakdown,
  // makespan, lateBy, etc. — applied on approval and shown with the request.
  details             Json?
  requestedById       String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  factory         Factory         @relation(fields: [factoryId], references: [id])
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  requestedBy     User?           @relation("RescheduleRequestedBy", fields: [requestedById], references: [id])
  reviewedBy      User?           @relation("RescheduleReviewedBy", fields: [reviewedById], references: [id])

  @@index([factoryId, status])
  @@index([productionOrderId])
  @@map("reschedule_requests")
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductionOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

// WORK ORDER (shop floor execution)
model WorkOrder {
  archivedAt        DateTime? // soft-archive (hidden from active lists, restorable)
  id                String               @id @default(uuid())
  factoryId         String
  productionOrderId String?
  lineId            String?
  skuId             String?
  shiftInstanceId   String?
  orderNumber       String               @unique
  status            WorkOrderStatus      @default(PLANNED)
  priority          Priority             @default(MEDIUM)
  // Auto-start: when true, the scheduler starts this WO (and cascades its job
  // orders) automatically once plannedStart arrives — no operator action needed.
  autoStart         Boolean              @default(false)
  plannedQty        Int
  actualQty         Int                  @default(0)
  goodQty           Int                  @default(0)
  scrapQty          Int                  @default(0)
  reworkQty         Int                  @default(0)
  // The unit the four quantities above are counted in. Previously ABSENT, which is
  // why goodQty (taken from the last routing step, e.g. PALLET) and scrapQty (summed
  // across steps counted in inners, cartons AND pallets) could sit in the same row
  // meaning different things. New writes normalise to PIECE; the column records that
  // so a stored number is never ambiguous again.
  qtyUnit           String               @default("PIECE")
  plannedStart      DateTime
  plannedEnd        DateTime
  actualStart       DateTime?
  actualEnd         DateTime?
  oee               Float?
  availability      Float?
  performance       Float?
  quality           Float?
  downtimeMinutes   Float                @default(0)
  plannedCycleTime  Float? // seconds per unit
  recipeId          String? // locked recipe at WO creation
  recipeVersion     String?
  // Material availability gate (driven by material_requests). OK = every step
  // material is in stock; AWAITING_MATERIALS = an open shortage request blocks
  // start; SCHEDULED_FOR_DELIVERY = start deferred until materialReadyDate (the
  // latest supplier delivery ETA submitted by inventory).
  materialStatus    MaterialAvailability @default(OK)
  materialReadyDate DateTime? // earliest allowed start (latest supplier delivery ETA)
  notes             String?
  createdById       String?
  startedById       String?
  completedById     String?
  operatorId        String?
  supervisorId      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  factory              Factory               @relation(fields: [factoryId], references: [id])
  productionOrder      ProductionOrder?      @relation(fields: [productionOrderId], references: [id])
  line                 ProductionLine?       @relation(fields: [lineId], references: [id])
  sku                  SKU?                  @relation(fields: [skuId], references: [id])
  shiftInstance        ShiftInstance?        @relation(fields: [shiftInstanceId], references: [id])
  createdBy            User?                 @relation("WOCreatedBy", fields: [createdById], references: [id])
  startedBy            User?                 @relation("WOStartedBy", fields: [startedById], references: [id])
  completedBy          User?                 @relation("WOCompletedBy", fields: [completedById], references: [id])
  operator             User?                 @relation("WOOperator", fields: [operatorId], references: [id])
  supervisor           User?                 @relation("WOSupervisor", fields: [supervisorId], references: [id])
  recipe               Recipe?               @relation(fields: [recipeId], references: [id])
  batchRecords         BatchRecord[]
  downtimeEvents       DowntimeEvent[]
  materialConsumptions MaterialConsumption[]
  productionEvents     ProductionEvent[]
  inspectionResults    InspectionResult[]
  energyWOSummary      EnergyWOSummary?
  energyWOMachineKpis  EnergyWOMachineKpi[]
  maintenanceOrders    MaintenanceWO[]       @relation("MaintLinkedProdWO")
  jobOrders            JobOrder[]
  scrapLogs            ScrapLog[]
  rescheduleRequests   RescheduleRequest[]
  finishedGoodsLots    FinishedGoodsLot[]
  materialRequests     MaterialRequest[]

  @@index([factoryId, status])
  @@index([factoryId, plannedStart])
  @@map("work_orders")
}

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

// PRODUCTION EVENT (state changes, count updates, etc.)
model ProductionEvent {
  id          String              @id @default(uuid())
  factoryId   String
  workOrderId String?
  machineId   String?
  shiftId     String?
  eventType   ProductionEventType
  timestamp   DateTime            @default(now())
  value       Float?
  skuId       String?
  metadata    Json?

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([factoryId, timestamp])
  @@index([machineId, timestamp])
  @@map("production_events")
}

enum ProductionEventType {
  WO_STARTED
  WO_COMPLETED
  WO_PAUSED
  COUNT_UPDATE
  SCRAP_RECORDED
  CHANGEOVER_START
  CHANGEOVER_END
  SHIFT_START
  SHIFT_END
  DOWNTIME_START
  DOWNTIME_END
  SPEED_CHANGE
  SKU_CHANGE
}

// ============================================================
// TRACEABILITY — BATCH / LOT RECORD
// ============================================================

model BatchRecord {
  id               String      @id @default(uuid())
  factoryId        String
  workOrderId      String? // legacy/primary WO (kept; = first of workOrderIds)
  workOrderIds     Json? // one-or-more linked Work Order ids (string[])
  skuId            String?
  batchNumber      String      @unique
  lotNumber        String?
  status           BatchStatus @default(ACTIVE)
  quantity         Int
  // AUTO = quantity is the live sum of linked WO planned quantities; MANUAL = entered/edited.
  quantitySource   String      @default("MANUAL")
  goodQuantity     Int         @default(0)
  scrapQuantity    Int         @default(0)
  unit             String      @default("CARTON")
  startTime        DateTime?
  endTime          DateTime?
  expiryDate       DateTime?
  releaseDate      DateTime?
  releasedById     String?
  electronicRecord Json? // EBR — process parameters, checkpoints
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  factory              Factory               @relation(fields: [factoryId], references: [id])
  workOrder            WorkOrder?            @relation(fields: [workOrderId], references: [id])
  sku                  SKU?                  @relation(fields: [skuId], references: [id])
  materialConsumptions MaterialConsumption[]
  genealogyAsChild     GenealogyLink[]       @relation("ChildBatch")
  genealogyAsParent    GenealogyLink[]       @relation("ParentBatch")
  inspectionResults    InspectionResult[]

  @@index([factoryId])
  @@index([lotNumber])
  @@map("batch_records")
}

enum BatchStatus {
  ACTIVE
  COMPLETED
  RELEASED
  REJECTED
  ON_HOLD
  QUARANTINE
  DEPLETED // material lot fully consumed (remainingQty = 0)
}

// MATERIAL LOT (incoming raw materials, packaging)
model MaterialLot {
  archivedAt        DateTime? // soft-archive (hidden from active lists, restorable)
  id                String      @id @default(uuid())
  factoryId         String
  rawMaterialId     String? // optional link to RawMaterial master
  materialCode      String
  materialName      String
  lotNumber         String
  supplierLot       String?
  supplierId        String?
  supplierName      String?
  quantity          Float
  remainingQty      Float
  unit              String // legacy text (kept in sync with unitRef.code)
  unitId            String? // FK to UnitOfMeasure (preferred)
  status            BatchStatus @default(ACTIVE)
  receivedAt        DateTime    @default(now())
  expiryDate        DateTime?
  storageLocation   String? // free-text (legacy)
  storageLocationId String? // FK to StorageLocation
  binNumber         String?
  notes             String?
  materialRequestId String? // received to fulfil this material-shortage request
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  factory            Factory               @relation(fields: [factoryId], references: [id])
  rawMaterial        RawMaterial?          @relation(fields: [rawMaterialId], references: [id])
  storageLocationRef StorageLocation?      @relation(fields: [storageLocationId], references: [id])
  unitRef            UnitOfMeasure?        @relation(fields: [unitId], references: [id])
  materialRequest    MaterialRequest?      @relation(fields: [materialRequestId], references: [id])
  consumptions       MaterialConsumption[]
  jobOrderMaterials  JobOrderMaterial[]
  storageTransfers   StorageTransfer[]

  @@unique([factoryId, lotNumber, materialCode])
  @@map("material_lots")
}

// MATERIAL CONSUMPTION (links batch to raw materials consumed)
model MaterialConsumption {
  id              String   @id @default(uuid())
  factoryId       String
  workOrderId     String?
  batchRecordId   String?
  materialLotId   String?
  materialCode    String
  materialName    String
  quantityPlanned Float
  quantityActual  Float    @default(0)
  unit            String
  consumedAt      DateTime @default(now())
  consumedById    String?
  jobOrderId      String? // the routing step (job order) that consumed it — enables incremental, per-step consumption

  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id])
  batchRecord BatchRecord? @relation(fields: [batchRecordId], references: [id])
  materialLot MaterialLot? @relation(fields: [materialLotId], references: [id])
  jobOrder    JobOrder?    @relation(fields: [jobOrderId], references: [id])

  @@index([batchRecordId])
  @@index([materialLotId])
  @@index([jobOrderId])
  @@map("material_consumptions")
}

// GENEALOGY LINK (parent-child batch relationships)
model GenealogyLink {
  id            String   @id @default(uuid())
  parentBatchId String
  childBatchId  String
  materialCode  String?
  quantity      Float?
  createdAt     DateTime @default(now())

  parentBatch BatchRecord @relation("ParentBatch", fields: [parentBatchId], references: [id])
  childBatch  BatchRecord @relation("ChildBatch", fields: [childBatchId], references: [id])

  @@unique([parentBatchId, childBatchId])
  @@map("genealogy_links")
}

// ============================================================
// SHIFTS
// ============================================================

model ShiftTemplate {
  id                     String   @id @default(uuid())
  factoryId              String
  code                   String
  name                   String
  nameAr                 String?
  startTime              String // HH:mm (24h)
  endTime                String // HH:mm (24h)
  crossesMidnight        Boolean  @default(false)
  plannedProductionHours Float // e.g. 11.0
  shiftDurationHours     Float // e.g. 12.0
  /// DEPRECATED — replaced by PlannedStopTemplate rows the user creates.
  /// Read by nothing; kept only until every factory has been migrated.
  breakMinutes           Int      @default(0)
  cleaningMinutes        Int      @default(0)
  days                   Json // [0=Sun,1=Mon,...,6=Sat]
  targetQtyPerShift      Int? // default production target per shift per line
  targetUnit             String   @default("CARTON") // unit of targetQtyPerShift: PIECE/INNER/CARTON/PALLET
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  /// Recurrence lives here now. `days` below is retained only so existing rows
  /// keep working until they are migrated; new code must read scheduleRule.
  scheduleRuleId String?

  factory      Factory               @relation(fields: [factoryId], references: [id])
  scheduleRule ScheduleRule?         @relation(fields: [scheduleRuleId], references: [id])
  instances    ShiftInstance[]
  plannedStops PlannedStopTemplate[]
  breaks       ShiftBreak[]

  @@unique([factoryId, code])
  @@map("shift_templates")
}

/// How often one of an order's planned stops recurs.
enum StopRecurrence {
  /// Once for the whole order, at its first actual start.
  ONCE
  /// Again at the start of every shift the order runs through.
  PER_SHIFT
  /// Again every time the order is resumed after a pause.
  PER_RESTART
}

/// A stop the plant KNOWS it will take when this order runs.
///
/// Cleaning, startup and changeover are not surprises — they are part of the
/// order, and until now the plant typed them in by hand every time. The plan
/// lives on the order; the EVENTS are created from it when the order actually
/// starts, per machine, so a plan edited tomorrow cannot rewrite yesterday.
///
/// Per machine, not per line: the events land against each step's own job
/// order, which is where the timeline, the OEE denominator and the counter all
/// already look. One line-wide event would have to be apportioned back to four
/// machines by something, and that something would be a second rule.
model ProductionOrderStop {
  id                String         @id @default(uuid())
  productionOrderId String
  /// CLEANING | STARTUP | CHANGEOVER | OTHER — drives the reason code only.
  kind              String         @default("OTHER")
  /// What the operator sees on the timeline. Free text, because a plant's own
  /// word for a stop beats a category every time.
  label             String
  durationMin       Int
  /// Order of execution within one occurrence. Two stops with the same sequence
  /// are laid out in the order they were created.
  sequence          Int            @default(0)
  recurrence        StopRecurrence @default(ONCE)
  /// Whether these minutes still cost the OEE reading. A changeover does; a
  /// meal break does not. Same meaning as on DowntimeEvent, deliberately.
  affectsOEE        Boolean        @default(true)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("production_order_stops")
}

/// A break inside a shift — as many as the shift actually has.
///
/// The template used to carry `breakMinutes` and `cleaningMinutes`: two numbers
/// with no start time, which could not express "twenty minutes at ten and forty
/// at one". Those fields are already marked deprecated and read by nothing.
///
/// Events are created when the shift OCCURRENCE begins, not in advance and not
/// forever — a break at 10:00 exists on the days that shift runs, and on no
/// others.
model ShiftBreak {
  id              String   @id @default(uuid())
  shiftTemplateId String
  label           String
  /// HH:mm, plant-local, inside the shift. A time outside the shift's own
  /// window is a configuration error and is reported rather than clamped.
  startTime       String
  durationMin     Int
  sequence        Int      @default(0)
  /// A meal break leaves the denominator; a cleaning break may not.
  affectsOEE      Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@index([shiftTemplateId])
  @@map("shift_breaks")
}

model ShiftInstance {
  id              String      @id @default(uuid())
  factoryId       String
  shiftTemplateId String
  lineId          String?
  shiftDate       DateTime // the calendar date (start date)
  startTime       DateTime
  endTime         DateTime?
  targetQty       Int?
  actualQty       Int         @default(0)
  goodQty         Int         @default(0)
  scrapQty        Int         @default(0)
  oee             Float?
  availability    Float?
  performance     Float?
  quality         Float?
  downtimeMinutes Float       @default(0)
  plannedDowntime Float       @default(0)
  operatorId      String?
  supervisorId    String?
  handoverNotes   String?
  status          ShiftStatus @default(PLANNED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  factory       Factory              @relation(fields: [factoryId], references: [id])
  shiftTemplate ShiftTemplate        @relation(fields: [shiftTemplateId], references: [id])
  line          ProductionLine?      @relation(fields: [lineId], references: [id])
  operator      User?                @relation("ShiftOperator", fields: [operatorId], references: [id])
  supervisor    User?                @relation("ShiftSupervisor", fields: [supervisorId], references: [id])
  workOrders    WorkOrder[]
  stateRecords  MachineStateRecord[]
  oeeRecords    OEERecord[]

  @@index([factoryId, shiftDate])
  @@map("shift_instances")
}

enum ShiftStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

// ============================================================
// OEE ENGINE — MACHINE STATE & DOWNTIME
// ============================================================

model MachineStateRecord {
  id              String       @id @default(uuid())
  factoryId       String
  machineId       String
  shiftInstanceId String?
  workOrderId     String?
  skuId           String?
  state           MachineState
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Float? // calculated on endTime set
  isPlannedStop   Boolean      @default(false)
  downtimeCauseId String?
  notes           String?
  source          String       @default("SYSTEM") // SYSTEM, OPERATOR, MAINTENANCE

  factory       Factory        @relation(fields: [factoryId], references: [id])
  machine       Machine        @relation(fields: [machineId], references: [id])
  shiftInstance ShiftInstance? @relation(fields: [shiftInstanceId], references: [id])
  downtimeCause DowntimeCause? @relation(fields: [downtimeCauseId], references: [id])

  @@index([factoryId, startTime])
  @@index([machineId, startTime])
  @@map("machine_state_records")
}

// DOWNTIME CAUSE (the plant pre-loaded codes per machine)
model DowntimeCause {
  id        String           @id @default(uuid())
  factoryId String
  machineId String? // null = applicable to all machines
  code      String
  name      String
  nameAr    String?
  category  DowntimeCategory
  isPlanned Boolean          @default(false)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  // 3-level PDM tree: level 1 = top category, 2 = sub-category, 3 = specific reason (leaf)
  level    Int             @default(3)
  parentId String?
  parent   DowntimeCause?  @relation("DowntimeCauseTree", fields: [parentId], references: [id], onDelete: SetNull)
  children DowntimeCause[] @relation("DowntimeCauseTree")

  factory              Factory               @relation(fields: [factoryId], references: [id])
  machine              Machine?              @relation(fields: [machineId], references: [id])
  stateRecords         MachineStateRecord[]
  downtimeEvents       DowntimeEvent[]
  plannedStopTemplates PlannedStopTemplate[]
  workOrderStopRules   WorkOrderStopRule[]

  @@index([factoryId])
  @@index([machineId])
  @@index([parentId])
  @@map("downtime_causes")
}

enum DowntimeCategory {
  MECHANICAL
  ELECTRICAL
  PROCESS
  MATERIAL
  OPERATOR
  CHANGEOVER
  UTILITY
  QUALITY
  PLANNED_MAINTENANCE
  PLANNED_CLEANING
  PLANNED_BREAK
  /// Bringing the line up at the head of a shift. Its own category rather than
  /// folded into CHANGEOVER: a changeover is between products, a startup is
  /// before the first one, and a plant shortening them does different things.
  STARTUP
  EXTERNAL
  OTHER
}

// DOWNTIME EVENT (logged, can be linked to maintenance WO)
// ISA-95 standardized 5-category downtime reason codes
enum DowntimeReasonCode {
  PLANNED_MAINTENANCE // PM, calibration, CIP — excluded from OEE Availability loss
  CHANGEOVER // format/product change — planned stop, reduces net production time
  UNPLANNED_BREAKDOWN // mechanical / electrical / process failure → Availability Loss
  MICRO_STOP // <5 min interruption → Performance Loss (speed loss category)
  STARVED // waiting for upstream material or step to deliver
  BLOCKED // waiting for downstream step / buffer to clear
  EXTERNAL // utilities, power, external cause beyond line control
}

model DowntimeEvent {
  id                   String             @id @default(uuid())
  factoryId            String
  machineId            String
  workCenterId         String? // ISA-95 WorkCenter link (replaces raw machine where routing is used)
  workOrderId          String?
  /// The job order that caused this stop, for work-order stop rules such as
  /// changeover. Without it a changeover cannot be traced back to the order
  /// that triggered it, which is the whole point of scheduling it.
  jobOrderId           String?
  shiftInstanceId      String?
  causeId              String?
  operatorId           String? // operator on shift who reported / triggered
  reason               String? // free text override / root cause description
  category             DowntimeCategory
  reasonCode           DowntimeReasonCode @default(UNPLANNED_BREAKDOWN)
  startTime            DateTime
  endTime              DateTime?
  durationMinutes      Float?
  affectsOEE           Boolean            @default(true) // false for PLANNED_MAINTENANCE, EXTERNAL
  isPlanned            Boolean            @default(false)
  reportedById         String?
  acknowledged         Boolean            @default(false)
  acknowledgedById     String?
  acknowledgedAt       DateTime?
  maintenanceWOId      String?
  schedulingImpactMins Float? // computed cascade delay pushed to dependent WO steps
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  factory    Factory        @relation(fields: [factoryId], references: [id])
  machine    Machine        @relation(fields: [machineId], references: [id])
  workCenter WorkCenter?    @relation("WCDowntimes", fields: [workCenterId], references: [id])
  workOrder  WorkOrder?     @relation(fields: [workOrderId], references: [id])
  jobOrder   JobOrder?      @relation(fields: [jobOrderId], references: [id])
  cause      DowntimeCause? @relation(fields: [causeId], references: [id])
  operator   User?          @relation("DowntimeOperator", fields: [operatorId], references: [id])

  @@index([factoryId, startTime])
  @@index([machineId, startTime])
  @@index([workCenterId, startTime])
  @@index([reasonCode])
  @@map("downtime_events")
}

// OEE RECORD (calculated and stored for reporting)
model OEERecord {
  id                   String   @id @default(uuid())
  factoryId            String
  machineId            String
  shiftInstanceId      String?
  recordDate           DateTime
  shiftCode            String?
  skuId                String?
  plannedProductionMin Float // minutes
  actualProductionMin  Float // minutes (excl planned stops)
  uptimeMin            Float // minutes actually running
  downtimeMin          Float // minutes unplanned downtime
  plannedDowntimeMin   Float    @default(0)
  totalOutput          Int
  goodOutput           Int
  scrapOutput          Int      @default(0)
  idealCycleTime       Float? // seconds per unit
  availability         Float // %
  performance          Float // %
  quality              Float // %
  oee                  Float // %
  calculatedAt         DateTime @default(now())

  factory       Factory        @relation(fields: [factoryId], references: [id])
  machine       Machine        @relation(fields: [machineId], references: [id])
  shiftInstance ShiftInstance? @relation(fields: [shiftInstanceId], references: [id])

  @@index([factoryId, recordDate])
  @@index([machineId, recordDate])
  @@map("oee_records")
}

// MACHINE RUNTIME HOURS (for PM scheduling)
model MachineRuntimeHours {
  id              String   @id @default(uuid())
  machineId       String
  factoryId       String
  recordDate      DateTime @db.Date
  dailyHours      Float
  cumulativeHours Float
  source          String   @default("CALCULATED") // CALCULATED, MANUAL
  createdAt       DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id])

  @@unique([machineId, recordDate])
  @@map("machine_runtime_hours")
}

// ============================================================
// QUALITY MANAGEMENT
// ============================================================

model QualityPlan {
  archivedAt        DateTime? // soft-archive (hidden from active lists, restorable)
  id                String    @id @default(uuid())
  factoryId         String
  skuId             String?
  machineId         String?
  code              String
  name              String
  type              String    @default("IN_PROCESS") // INCOMING, IN_PROCESS, FINAL
  samplingFrequency String? // EVERY_BATCH, HOURLY, etc.
  samplingQty       Int       @default(1)
  version           String    @default("1")
  isActive          Boolean   @default(true)
  approvedAt        DateTime?
  approvedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  factory    Factory            @relation(fields: [factoryId], references: [id])
  parameters QualityParameter[]
  results    InspectionResult[]

  @@map("quality_plans")
}

model QualityParameter {
  id           String  @id @default(uuid())
  planId       String
  name         String
  unit         String?
  nominalValue Float?
  ucl          Float? // upper control limit
  lcl          Float? // lower control limit
  usl          Float? // upper spec limit
  lsl          Float? // lower spec limit
  checkMethod  String?
  isKPI        Boolean @default(false)
  sortOrder    Int     @default(0)

  plan    QualityPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  spcTags TagDefinition[] @relation("TagSpc")

  @@map("quality_parameters")
}

model InspectionResult {
  archivedAt       DateTime? // soft-archive (hidden from active lists, restorable)
  id               String            @id @default(uuid())
  factoryId        String
  planId           String?
  workOrderId      String?
  batchRecordId    String?
  machineId        String?
  inspectionNumber String            @unique
  type             InspectionType
  result           InspectionResult2 @default(PENDING)
  totalQty         Int
  passQty          Int               @default(0)
  failQty          Int               @default(0)
  // Unit the inspected quantities are counted in. FPY and Defect Rate are ratios so
  // they survive a unit mismatch, but the absolute counts feed scrap/yield roll-ups
  // that do not — hence the label.
  qtyUnit          String            @default("PIECE")
  measurements     Json? // [{parameterId, value, pass}]
  checklistData    Json?
  attachments      Json?
  inspectorId      String
  inspectedAt      DateTime          @default(now())
  approvedById     String?
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  factory     Factory      @relation(fields: [factoryId], references: [id])
  plan        QualityPlan? @relation(fields: [planId], references: [id])
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id])
  batchRecord BatchRecord? @relation(fields: [batchRecordId], references: [id])
  machine     Machine?     @relation(fields: [machineId], references: [id])
  inspector   User         @relation("InspectionInspector", fields: [inspectorId], references: [id])

