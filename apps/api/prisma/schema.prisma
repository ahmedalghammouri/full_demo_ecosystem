model EnergyMeter {
  id           String     @id @default(uuid())
  factoryId    String
  // Scope target — a meter measures exactly one of: a machine, a line, or an area.
  machineId    String?
  lineId       String?
  areaId       String?
  deviceId     String?    @unique // physical comms endpoint (Modbus device) polled by the edge gateway
  meterNumber  String
  name         String
  nameAr       String?
  type         EnergyType
  unit         String // kWh, m3, L, kW
  brand        String?
  manufacturer String?
  model        String? // e.g. METSEPM5110, 7KM2200
  templateKey  String? // register-map template, e.g. SCHNEIDER_PM5110, SIEMENS_PAC3200
  location     String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  factory   Factory         @relation(fields: [factoryId], references: [id])
  machine   Machine?        @relation(fields: [machineId], references: [id])
  line      ProductionLine? @relation(fields: [lineId], references: [id])
  area      Area?           @relation(fields: [areaId], references: [id])
  device    Device?         @relation(fields: [deviceId], references: [id])
  tags      TagDefinition[]
  readings  EnergyReading[]
  pqEvents          PqEvent[]
  harmonicSnapshots HarmonicSnapshot[]
  en50160           En50160Assessment[]
  summaries EnergySummary[]

  @@unique([factoryId, meterNumber])
  @@map("energy_meters")
}

enum EnergyType {
  ELECTRICAL
  NATURAL_GAS
  COMPRESSED_AIR
  WATER
  STEAM
  CHILLED_WATER
}

model EnergyReading {
  id                String   @id @default(uuid())
  meterId           String
  factoryId         String
  workCenterId      String? // WorkCenter active at reading time (for production context)
  workOrderId       String? // WO active at reading time
  productionOrderId String? // PO active at reading time (correlation/rollup)
  machineId         String? // specific machine if meter is machine-level
  lineId            String? // line if meter is line-level
  shiftInstanceId   String?
  timestamp         DateTime
  value             Float // cumulative kWh / m³ (delta calculated at aggregation)
  powerKw           Float? // instantaneous power draw at this timestamp
  /// A power meter reports these alongside energy, and the reactive figure is
  /// what a low power factor actually costs — leaving them out meant the
  /// compensation case had to be re-derived from a curve instead of read.
  powerFactor       Float?
  reactiveKvar      Float?
  unit              String
  machineState      String? // snapshot: RUNNING | IDLE | BREAKDOWN | PLANNED_STOP
  source            String   @default("AUTO") // AUTO (from IoT), MANUAL
  quality           String   @default("GOOD")
  createdAt         DateTime @default(now())

  factory    Factory     @relation(fields: [factoryId], references: [id])
  meter      EnergyMeter @relation(fields: [meterId], references: [id])
  workCenter WorkCenter? @relation("WCEnergyReadings", fields: [workCenterId], references: [id])

  @@index([meterId, timestamp])
  @@index([factoryId, timestamp])
  @@index([workOrderId])
  @@index([workCenterId, timestamp])
  @@map("energy_readings")
}

// Aggregated energy consumption per Work Order (computed on WO close)
model EnergyWOSummary {
  id            String   @id @default(uuid())
  workOrderId   String   @unique
  factoryId     String
  totalKwh      Float // total electrical energy over WO duration
  runningKwh    Float    @default(0) // energy while machineState = RUNNING
  idleKwh       Float    @default(0) // energy while machineState = IDLE (waste)
  downtimeKwh   Float    @default(0) // energy while machineState = BREAKDOWN (waste)
  kwhPerUnit    Float? // totalKwh / qtyProduced
  kwhPerKgBatch Float? // totalKwh / batchSize (kg)
  peakPowerKw   Float? // maximum instantaneous power recorded
  avgPowerKw    Float? // average power over run period
  anomalyCount  Int      @default(0) // #readings where powerKw > threshold during idle/down
  computedAt    DateTime @default(now())

  factory   Factory   @relation(fields: [factoryId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@map("energy_wo_summaries")
}

// Energy ratio per WORK ORDER × MACHINE — the operational-level energy KPI.
//
// EnergyWOSummary above answers "what did this work order cost in kWh"; it cannot
// answer "which machine spent it", because it is keyed on the work order alone.
// This table adds the machine dimension, so specific energy consumption can be
// compared machine-to-machine on the same order and order-to-order on the same
// machine — the basis for any energy-efficiency work.
//
// Computed from EnergyReading, which already carries both workOrderId and
// machineId (stamped by EnergyContextService.enrichEnergyReading). Recomputed on
// WO completion and on demand; never hand-written.
model EnergyWOMachineKpi {
  id          String @id @default(uuid())
  factoryId   String
  workOrderId String
  machineId   String
  meterCount  Int    @default(0) // how many meters fed this row

  // Consumption, split by the machine state at the time of each reading.
  totalKwh    Float @default(0)
  runningKwh  Float @default(0)
  idleKwh     Float @default(0) // energy burned while idle — recoverable waste
  downtimeKwh Float @default(0) // energy burned while stopped — recoverable waste

  // ── The energy ratios ────────────────────────────────────────────────
  kwhPerUnit           Float? // totalKwh / good output, in the WO's base unit (kWh/carton)
  kwhPerKg             Float? // totalKwh / kg of product — comparable across pack sizes
  kwhPerRunHour        Float? // totalKwh / running hours — a load figure, not an efficiency one
  // Same ratio counting only the energy spent while actually producing. The gap
  // between this and kwhPerUnit is the idle/downtime penalty per unit.
  productiveKwhPerUnit Float?
  // Share of total energy that produced nothing: (idle + downtime) / total × 100.
  wastePct             Float?

  // Benchmark — the best kwhPerUnit previously recorded for this machine+SKU, so
  // the UI can show drift against demonstrated best rather than an arbitrary target.
  baselineKwhPerUnit Float?
  variancePct        Float? // (kwhPerUnit − baseline) / baseline × 100; + is worse

  peakPowerKw Float?
  avgPowerKw  Float?

  goodQty    Float? // output this ratio is divided by (base unit)
  outputUnit String? // CARTON | INNER | PALLET — what goodQty counts
  runMinutes Float   @default(0)

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  factory   Factory   @relation(fields: [factoryId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  machine   Machine   @relation(fields: [machineId], references: [id])

  @@unique([workOrderId, machineId])
  @@index([factoryId, computedAt])
  @@index([machineId, computedAt])
  @@map("energy_wo_machine_kpis")
}

model EnergySummary {
  id               String       @id @default(uuid())
  meterId          String
  factoryId        String
  periodType       EnergyPeriod
  periodStart      DateTime
  periodEnd        DateTime
  totalConsumption Float
  unit             String
  cost             Float?
  costCurrency     String       @default("SAR")
  productionQty    Float?
  specificEnergy   Float? // kWh/unit
  createdAt        DateTime     @default(now())

  factory Factory     @relation(fields: [factoryId], references: [id])
  meter   EnergyMeter @relation(fields: [meterId], references: [id])

  @@index([meterId, periodStart])
  @@map("energy_summaries")
}

enum EnergyPeriod {
  HOURLY
  SHIFT
  DAILY
  WEEKLY
  MONTHLY
}

// Configurable energy cost rate, scoped from most-specific to least:
// machine > line > area > factory-default. Resolved per meter (by its scope +
// energy type) to turn consumption into cost. One enabled row wins per scope.
// ============================================================
// SCOPE 2 GRID EMISSION FACTOR (GHG Protocol, location-based)
// ============================================================
// Purchased-electricity emissions = kWh consumed × factor. The factor is stored
// here — never hard-coded — so it can be revised without a release when the grid
// mix or the reporting standard changes. Versioned by effective date so a past
// period keeps the factor that was in force at the time.
model GridEmissionFactor {
  id             String    @id @default(uuid())
  factoryId      String
  factorKgPerKwh Float // kg CO2e per kWh of purchased electricity
  unit           String    @default("kg CO2e/kWh")
  source         String? // provenance, e.g. "Operator-supplied KSA national grid factor"
  effectiveFrom  DateTime
  effectiveTo    DateTime? // null = still in force
  isActive       Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])

  @@index([factoryId, isActive, effectiveFrom])
  @@map("grid_emission_factors")
}

