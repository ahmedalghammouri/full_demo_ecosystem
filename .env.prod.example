# ══════════════════════════════════════════════════════════════════
#  i360 — production environment
#
#    cp .env.prod.example .env
#    # change every secret below, then:
#    docker compose -f docker-compose.yml -f docker-compose.traefik.yml \
#      -p i360 up -d --build
#
#  This host already runs other stacks. Nothing here may collide with
#  them, which is what BIND_ADDR and the port block below are for.
# ══════════════════════════════════════════════════════════════════

# ── Public routing ────────────────────────────────────────────────
# Traefik matches on this Host(). Point the DNS A record at this server
# before the first boot, or Let's Encrypt cannot complete the challenge
# and the router serves its default self-signed certificate instead.
PUBLIC_DOMAIN=i360.industry360.cloud

# ── Exposure ──────────────────────────────────────────────────────
# THE SINGLE MOST IMPORTANT LINE IN THIS FILE.
#
# 0.0.0.0 publishes every port below on the public interface — the
# database, the cache, the MQTT broker and the object store included.
# 127.0.0.1 keeps them on loopback, reachable through Traefik (which
# dials the container directly, not through a published port) or an SSH
# tunnel, and from nowhere else.
#
# Leave this as 127.0.0.1 in production. Always.
BIND_ADDR=127.0.0.1

# ── Host ports ────────────────────────────────────────────────────
# Only the host side. Container-internal ports never change, so nothing
# else has to follow when these move. Defaults sit clear of the sibling
# stacks already running on this box.
WEB_PORT=3100
API_PORT_HOST=4100
HTTP_PORT=8100
HTTPS_PORT=8543
POSTGRES_PORT=5434
REDIS_PORT_HOST=6380
INFLUX_PORT=8087
MQTT_PORT=1884
MQTT_WS_PORT=9003
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
PROMETHEUS_PORT=9091
GRAFANA_PORT=3103

# ── Secrets — CHANGE EVERY ONE ────────────────────────────────────
# The compose defaults are published in a git repository. Treat any
# value you did not type yourself as already compromised.
POSTGRES_PASSWORD=change-me-a-long-random-string
JWT_SECRET=change-me-at-least-32-characters-long-random
JWT_REFRESH_SECRET=change-me-a-different-32-character-random
INFLUX_TOKEN=change-me-influx-token
INFLUX_PASSWORD=change-me-influx-admin-password
MINIO_ROOT_USER=i360admin
MINIO_ROOT_PASSWORD=change-me-minio-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ── Demo accounts ─────────────────────────────────────────────────
# The seeded accounts use a published password so a reviewer can sign in
# without being handed credentials. That is correct for a demonstration
# and wrong for anything else. If this deployment ever carries real
# data, delete them.
DEMO_PASSWORD=Demo@2026

# ── Data ──────────────────────────────────────────────────────────
# Days of transactional history to generate on first boot. The daily
# rollups run further back than the per-unit records: a year of trend
# depth without a year of row count.
SEED_HISTORY_DAYS=14
SEED_ROLLUP_DAYS=365
# Set true for ONE boot to rebuild history after changing the plant
# model. The existing rows came from the old model and will disagree
# with it.
SEED_RESET=false

# ── Basemap ───────────────────────────────────────────────────────
# The landing map is the one asset that reaches outside this server.
# OpenStreetMap needs no key. Point this at an internal tile server if
# the demonstration has to run without internet access.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Timezone ──────────────────────────────────────────────────────
# Shift boundaries, working days and every daily rollup are computed in
# this zone. Getting it wrong moves the night shift onto the wrong day.
TZ=Asia/Riyadh
